#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# fuvrctl — convenience CLI for installing, inspecting, and benchmarking FuVR.
#
# This is a thin orchestrator over the lower-level scripts and binaries under
# `scripts/` and `build/`. It exists so contributors and users can run a
# single command instead of memorizing the launchd / OpenXR / adb dance.
set -euo pipefail

# ---------------------------------------------------------------------------
# Paths and constants
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
BUILD_DIR="${BUILD_DIR:-$REPO_ROOT/build}"
OPENXR_DIR="$HOME/Library/Application Support/OpenXR/1"
ACTIVE_RUNTIME_JSON="$OPENXR_DIR/active_runtime.json"
RUNTIME_DYLIB_DEST="$OPENXR_DIR/runtime.dylib"
RUNTIME_DYLIB_SRC="$BUILD_DIR/runtime-macos/libfuvr_openxr_runtime.dylib"
DAEMON_UDS="${FUVRD_UDS:-/tmp/fuvrd.sock}"
DAEMON_OUT_LOG="/tmp/fuvrd.out.log"
DAEMON_ERR_LOG="/tmp/fuvrd.err.log"
APK_PATH="$REPO_ROOT/quest-app/app/build/outputs/apk/debug/app-debug.apk"

# ---------------------------------------------------------------------------
# Color helpers — only enable if stdout is a TTY with >= 8 colors.
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
  C_RESET=$(tput sgr0)
  C_BOLD=$(tput bold)
  C_RED=$(tput setaf 1)
  C_GREEN=$(tput setaf 2)
  C_YELLOW=$(tput setaf 3)
  C_BLUE=$(tput setaf 4)
  C_DIM=$(tput dim 2>/dev/null || echo "")
else
  C_RESET=""; C_BOLD=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_DIM=""
fi

info()  { printf "%s[fuvrctl]%s %s\n" "$C_BLUE" "$C_RESET" "$*"; }
ok()    { printf "%s[ ok ]%s %s\n" "$C_GREEN" "$C_RESET" "$*"; }
warn()  { printf "%s[warn]%s %s\n" "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()   { printf "%s[err ]%s %s\n" "$C_RED" "$C_RESET" "$*" >&2; }
die()   { err "$*"; exit 1; }

# ---------------------------------------------------------------------------
# Top-level help
# ---------------------------------------------------------------------------
usage_top() {
  cat <<'USAGE'
fuvrctl — FuVR control plane CLI

Usage:
  fuvrctl <subcommand> [args...]

Subcommands:
  install              Build, install LaunchAgent, register OpenXR runtime
  uninstall            Reverse install
  status               Show daemon + runtime + OpenXR registration state
  logs                 Tail /tmp/fuvrd.{out,err}.log
  quest install        Install the debug APK on a connected Quest
  quest reverse        Set up adb reverse tcp:9943 tcp:9943
  bench                Run M0 spike benches and write a Markdown report
  -h, --help           Show this help

Run `fuvrctl <subcommand> --help` for details on each subcommand.
USAGE
}

# ---------------------------------------------------------------------------
# Subcommand: install
# ---------------------------------------------------------------------------
usage_install() {
  cat <<'USAGE'
fuvrctl install — build FuVR and register it with the system.

Steps performed (in order):
  1. scripts/gen-proto.sh                (Cap'n Proto bindings)
  2. cmake -B build && cmake --build build  (native components)
  3. scripts/install-launchd.sh          (LaunchAgent for fuvrd)
  4. Copy runtime dylib into ~/Library/Application Support/OpenXR/1/
  5. Write active_runtime.json so OpenXR loaders pick it up

Idempotent: re-running upgrades the existing install.
USAGE
}

cmd_install() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then usage_install; return 0; fi

  info "Generating Cap'n Proto bindings"
  "$SCRIPT_DIR/gen-proto.sh"

  info "Configuring and building (cmake)"
  cmake -B "$BUILD_DIR" -S "$REPO_ROOT"
  cmake --build "$BUILD_DIR" --parallel

  info "Installing fuvrd LaunchAgent"
  "$SCRIPT_DIR/install-launchd.sh"

  info "Registering OpenXR runtime in $OPENXR_DIR"
  mkdir -p "$OPENXR_DIR"
  if [ ! -f "$RUNTIME_DYLIB_SRC" ]; then
    die "runtime dylib not found at $RUNTIME_DYLIB_SRC; build failed?"
  fi
  cp "$RUNTIME_DYLIB_SRC" "$RUNTIME_DYLIB_DEST"

  cat > "$ACTIVE_RUNTIME_JSON" <<JSON
{
  "file_format_version": "1.0.0",
  "runtime": {
    "library_path": "$RUNTIME_DYLIB_DEST",
    "name": "FuVR",
    "MND_egl_enable": true
  }
}
JSON
  ok "OpenXR runtime active: $ACTIVE_RUNTIME_JSON"
  ok "Install complete. Try: fuvrctl status"
}

# ---------------------------------------------------------------------------
# Subcommand: uninstall
# ---------------------------------------------------------------------------
usage_uninstall() {
  cat <<'USAGE'
fuvrctl uninstall — undo `fuvrctl install`.

Removes:
  - LaunchAgent plist + booted-out service
  - OpenXR runtime dylib + active_runtime.json (only if it points at FuVR)

Build artifacts under build/ are kept; remove them manually if desired.
USAGE
}

cmd_uninstall() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then usage_uninstall; return 0; fi

  info "Removing LaunchAgent"
  "$SCRIPT_DIR/uninstall-launchd.sh" || true

  if [ -f "$ACTIVE_RUNTIME_JSON" ] && grep -q "FuVR" "$ACTIVE_RUNTIME_JSON" 2>/dev/null; then
    info "Removing OpenXR registration"
    rm -f "$ACTIVE_RUNTIME_JSON" "$RUNTIME_DYLIB_DEST"
    ok "Removed $ACTIVE_RUNTIME_JSON"
  else
    warn "active_runtime.json missing or not FuVR's — leaving alone"
  fi

  ok "Uninstall complete"
}

# ---------------------------------------------------------------------------
# Subcommand: status
# ---------------------------------------------------------------------------
usage_status() {
  cat <<'USAGE'
fuvrctl status — show daemon, runtime, and OpenXR registration state.

Outputs (best-effort, never fails):
  - launchd service state for com.fuvr.daemon
  - PID and UDS reachability for fuvrd
  - active_runtime.json contents
  - LaunchAgent plist presence
USAGE
}

cmd_status() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then usage_status; return 0; fi

  printf "%sFuVR status%s\n" "$C_BOLD" "$C_RESET"

  local domain="gui/$(id -u)"
  if launchctl print "$domain/com.fuvr.daemon" >/dev/null 2>&1; then
    local pid
    pid=$(launchctl print "$domain/com.fuvr.daemon" 2>/dev/null | awk '/pid =/ {print $3; exit}')
    ok "LaunchAgent loaded (pid=${pid:-?})"
  else
    warn "LaunchAgent not loaded (run: fuvrctl install)"
  fi

  if [ -S "$DAEMON_UDS" ]; then
    ok "Daemon UDS present: $DAEMON_UDS"
    if command -v nc >/dev/null 2>&1; then
      printf '{"op":"ping"}\n' | nc -U -w 1 "$DAEMON_UDS" 2>/dev/null \
        | head -c 256 | sed 's/^/    /' || true
      printf "\n"
    fi
  else
    warn "Daemon UDS missing: $DAEMON_UDS"
  fi

  if [ -f "$ACTIVE_RUNTIME_JSON" ]; then
    ok "OpenXR active_runtime.json:"
    sed 's/^/    /' "$ACTIVE_RUNTIME_JSON"
  else
    warn "OpenXR runtime not registered ($ACTIVE_RUNTIME_JSON missing)"
  fi
}

# ---------------------------------------------------------------------------
# Subcommand: logs
# ---------------------------------------------------------------------------
usage_logs() {
  cat <<'USAGE'
fuvrctl logs — tail fuvrd stdout + stderr logs.

Equivalent to:
  tail -F /tmp/fuvrd.out.log /tmp/fuvrd.err.log

Press Ctrl-C to stop.
USAGE
}

cmd_logs() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then usage_logs; return 0; fi
  local files=()
  [ -f "$DAEMON_OUT_LOG" ] && files+=("$DAEMON_OUT_LOG")
  [ -f "$DAEMON_ERR_LOG" ] && files+=("$DAEMON_ERR_LOG")
  if [ ${#files[@]} -eq 0 ]; then
    die "no log files yet; is fuvrd running? try: fuvrctl status"
  fi
  exec tail -F "${files[@]}"
}

# ---------------------------------------------------------------------------
# Subcommand: quest <install|reverse>
# ---------------------------------------------------------------------------
usage_quest() {
  cat <<'USAGE'
fuvrctl quest <install|reverse>

  install   Install (or reinstall) the debug APK on a connected Quest.
            Delegates to scripts/install-quest.sh.
  reverse   adb reverse tcp:9943 tcp:9943, so the headset can dial the Mac
            over USB. Prints the discovered host:port for use in the app.
USAGE
}

cmd_quest() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    install)
      [ "${1:-}" = "--help" ] && { usage_quest; return 0; }
      "$SCRIPT_DIR/install-quest.sh" "$@"
      ;;
    reverse)
      command -v adb >/dev/null 2>&1 || die "adb not found in PATH"
      info "Setting up adb reverse tcp:9943 tcp:9943"
      adb reverse tcp:9943 tcp:9943
      ok "Quest can now reach the Mac at 127.0.0.1:9943 (FuVR transport)"
      info "Verify with: adb reverse --list"
      ;;
    -h|--help|"")
      usage_quest
      ;;
    *)
      die "unknown quest subcommand: $sub (try: fuvrctl quest --help)"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Subcommand: bench
# ---------------------------------------------------------------------------
usage_bench() {
  cat <<'USAGE'
fuvrctl bench — run the four M0 spike tools and produce a Markdown report.

Tools invoked (must already be built):
  - fuvr-encode-synthetic       (encoder-macos)
  - transport-cli loopback-bench (transport)
  - fuvr-vdisplay-helper        (virtual-display-helper)
  - fuvr-runtime-metrics        (runtime-macos)

Output:
  bench-output/M0-report-YYYY-MM-DD-HHMMSS.md

Failed tools are recorded in the report rather than aborting the run.
USAGE
}

cmd_bench() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then usage_bench; return 0; fi

  local out_dir="$REPO_ROOT/bench-output"
  mkdir -p "$out_dir"
  local stamp
  stamp="$(date +%Y-%m-%d-%H%M%S)"
  local report="$out_dir/M0-report-$stamp.md"

  info "Writing bench report to $report"

  {
    printf "# FuVR M0 Bench Report\n\n"
    printf "_Generated: %s_\n\n" "$(date)"
    printf "_Host: %s (%s)_\n\n" "$(hostname)" "$(uname -srm)"
    printf "## Summary\n\n"
    printf "| Tool | Result |\n|---|---|\n"
  } > "$report"

  run_one() {
    local name="$1"; shift
    local bin="$1"; shift
    local label="$name"
    {
      printf "\n## %s\n\n" "$label"
      printf "Command: \`%s %s\`\n\n" "$bin" "$*"
      printf "\`\`\`\n"
    } >> "$report"
    if [ -x "$bin" ]; then
      if "$bin" "$@" >> "$report" 2>&1; then
        printf "\`\`\`\n" >> "$report"
        printf "| %s | ok |\n" "$label" >> "$report.summary.tmp"
        ok "$label: ok"
      else
        printf "\`\`\`\n_(non-zero exit)_\n" >> "$report"
        printf "| %s | failed |\n" "$label" >> "$report.summary.tmp"
        warn "$label: failed"
      fi
    else
      printf "_(binary not found at %s — skipped)_\n" "$bin" >> "$report"
      printf "| %s | missing |\n" "$label" >> "$report.summary.tmp"
      warn "$label: missing ($bin)"
    fi
  }

  : > "$report.summary.tmp"

  run_one "fuvr-encode-synthetic"      "$BUILD_DIR/encoder-macos/fuvr-encode-synthetic"
  run_one "transport loopback-bench"   "$BUILD_DIR/../transport/target/release/transport-cli" loopback-bench
  run_one "fuvr-vdisplay-helper"       "$BUILD_DIR/virtual-display-helper/fuvr-vdisplay-helper" --probe
  run_one "fuvr-runtime-metrics"       "$BUILD_DIR/runtime-macos/fuvr-runtime-metrics"

  if [ -s "$report.summary.tmp" ]; then
    cat "$report.summary.tmp" >> "$report"
  fi
  rm -f "$report.summary.tmp"

  ok "Report ready: $report"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
main() {
  local sub="${1:-}"
  case "$sub" in
    ""|-h|--help|help) usage_top ;;
    install)            shift; cmd_install "$@" ;;
    uninstall)          shift; cmd_uninstall "$@" ;;
    status)             shift; cmd_status "$@" ;;
    logs)               shift; cmd_logs "$@" ;;
    quest)              shift; cmd_quest "$@" ;;
    bench)              shift; cmd_bench "$@" ;;
    *)                  err "unknown subcommand: $sub"; usage_top; exit 2 ;;
  esac
}

main "$@"
