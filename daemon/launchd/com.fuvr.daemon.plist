<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fuvr.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/fuvrd</string>
  </array>
  <key>MachServices</key>
  <dict>
    <key>com.fuvr.daemon.surface</key>
    <true/>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/fuvrd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/fuvrd.err.log</string>
</dict>
</plist>
